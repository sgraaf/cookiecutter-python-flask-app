# Flask builtin configuration values
FLASK_APP=wsgi.py
# Generate with: `python -c 'import secrets; print(secrets.token_urlsafe())'`
SECRET_KEY=your-secret-key-here

# SQLAlchemy engine configurations
# The database connection URI used for the default engine.
SQLALCHEMY_DATABASE_URI=sqlite:///{{ cookiecutter.package_name}}.sqlite3
